GROQ_API_KEY=
TAVILY_API_KEY=
LANGCHAIN_API_KEY=

# Phase 2 FastAPI platform
# SQLite is the local default. Use a PostgreSQL URL in deployment.
DATABASE_URL=sqlite:///./data/hotel_platform.db
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081
API_V1_PREFIX=/api/v1
SEED_DATABASE=true
FIRST_TIME_WELCOME_DISCOUNT=10
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEV_MANAGER_EMAIL=manager@example.com
DEV_MANAGER_PASSWORD=
ML_MODEL_PATH=backend/ml/artifacts/risk_model.joblib
ML_LOW_RISK_THRESHOLD=0.40
ML_HIGH_RISK_THRESHOLD=0.70
RAG_ENABLED=true
RAG_COLLECTION_NAME=hotel_retention_policy
RAG_PERSIST_DIRECTORY=backend/rag_store
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_POLICY_DOCUMENT_PATH=data/policy/Company_Retention_Policy_2026.pdf
LANGGRAPH_CHECKPOINT_PATH=backend/data/langgraph_checkpoints.db
NL_SQL_ENABLED=true
NL_SQL_MAX_ROWS=100
NL_SQL_TIMEOUT_SECONDS=10
# Enable only when GROQ_API_KEY is configured. SQL still passes AST validation.
NL_SQL_LLM_ENABLED=false
NL_SQL_LLM_MODEL=openai/gpt-oss-20b
