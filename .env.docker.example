# Copy to .env and replace every CHANGE_ME value before `docker compose up --build`.
POSTGRES_DB=hotel_platform
POSTGRES_USER=hotel_platform
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_LOCAL_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
DEV_MANAGER_EMAIL=manager@example.com
DEV_MANAGER_PASSWORD=CHANGE_ME_LOCAL_MANAGER_PASSWORD
BACKEND_PORT=8000
CUSTOMER_FRONTEND_PORT=8082
MANAGER_FRONTEND_PORT=8081
CUSTOMER_API_BASE_URL=
MANAGER_API_BASE_URL=
CORS_ORIGINS=http://localhost:8082,http://localhost:8081
AUTO_CREATE_SCHEMA=false
SEED_DATABASE=true
RESET_SEED_MANAGER_PASSWORD=false
ML_MODEL_PATH=backend/ml/artifacts/risk_model.joblib
RAG_ENABLED=true
RAG_COLLECTION_NAME=hotel_retention_policy
RAG_PERSIST_DIRECTORY=/var/lib/hotel/rag_store
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_POLICY_DOCUMENT_PATH=data/policy/Company_Retention_Policy_2026.pdf
LANGGRAPH_CHECKPOINT_PATH=/var/lib/hotel/langgraph/checkpoints.db

# Optional: leave empty to use the deterministic local NL→SQL planner.
GROQ_API_KEY=
NL_SQL_LLM_ENABLED=false
NL_SQL_LLM_MODEL=openai/gpt-oss-20b
