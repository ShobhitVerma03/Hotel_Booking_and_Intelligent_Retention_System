# Copy outside source control and replace every CHANGE_ME value. Never use this
# file directly as production secrets.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://hotel_user:CHANGE_ME_DATABASE_PASSWORD@postgres-host:5432/hotel_platform
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://customer.example.com,https://manager.example.com

# Production schema is managed by Alembic before the web process starts.
AUTO_CREATE_SCHEMA=false
SEED_DATABASE=false
RESET_SEED_MANAGER_PASSWORD=false
DEV_MANAGER_EMAIL=manager@example.com
DEV_MANAGER_PASSWORD=CHANGE_ME_ONLY_IF_SEEDING_A_NEW_MANAGER

ML_MODEL_PATH=backend/ml/artifacts/risk_model.joblib
ML_LOW_RISK_THRESHOLD=0.40
ML_HIGH_RISK_THRESHOLD=0.70
RAG_ENABLED=true
RAG_COLLECTION_NAME=hotel_retention_policy
RAG_PERSIST_DIRECTORY=/var/lib/hotel/rag_store
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_POLICY_DOCUMENT_PATH=data/policy/Company_Retention_Policy_2026.pdf
LANGGRAPH_CHECKPOINT_PATH=/var/lib/hotel/langgraph/checkpoints.db

# Optional LLM features. Keep disabled unless a provider key is provisioned.
GROQ_API_KEY=
NL_SQL_ENABLED=true
NL_SQL_LLM_ENABLED=false
NL_SQL_LLM_MODEL=openai/gpt-oss-20b
NL_SQL_MAX_ROWS=100
NL_SQL_TIMEOUT_SECONDS=10

# Set each frontend's build-time VITE_API_BASE_URL to this public API URL.
FRONTEND_API_URL=https://api.example.com
